{
  "ConnectionStrings": {
    "TrackGRN": "Server=(localdb)\\MSSQLLocalDB;Database=TrackGRN;Integrated Security=true;TrustServerCertificate=true;"
  },
  "Jwt": {
    "Issuer": "TrackGRN.Api",
    "Audience": "TrackGRN.UI",
    "Key": "TrackGRN-development-only-signing-key-replace-in-production",
    "AccessTokenMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Printing": {
    "Mode": "WindowsSpooler",
    "PrinterName": "ZDesigner ZD230-203dpi ZPL",
    "Host": null,
    "Port": 9100,
    "Dpi": 203
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "CHANGE_ME_BEFORE_SEEDING",
    "AdminFullName": "TrackGRN Administrator",
    "AdminEmployeeCode": "ADMIN"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "APItrackGRN/logs/trackgrn-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
