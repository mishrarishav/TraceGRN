{
  "name": "trackgrn-workspace",
  "private": true,
  "scripts": {
    "ui": "npm --prefix UItrackGRN run dev",
    "ui:install": "npm --prefix UItrackGRN install",
    "ui:build": "npm --prefix UItrackGRN run build",
    "ui:lint": "npm --prefix UItrackGRN run lint",
    "ui:e2e": "npm --prefix UItrackGRN run test:e2e",
    "ui:e2e:desktop": "npm --prefix UItrackGRN run test:e2e:desktop",
    "ui:e2e:mobile": "npm --prefix UItrackGRN run test:e2e:mobile",
    "api": "dotnet run --project APItrackGRN/src/APItrackGRN.Api/APItrackGRN.Api.csproj --",
    "api:watch": "dotnet watch --project APItrackGRN/src/APItrackGRN.Api/APItrackGRN.Api.csproj run",
    "api:build": "dotnet build APItrackGRN/APItrackGRN.sln",
    "api:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File APItrackGRN/scripts/smoke-test.ps1",
    "api:test": "dotnet test APItrackGRN/APItrackGRN.sln --no-restore",
    "migrate": "dotnet run --project APItrackGRN/src/APItrackGRN.Api/APItrackGRN.Api.csproj -- --migrate",
    "seed": "dotnet run --project APItrackGRN/src/APItrackGRN.Api/APItrackGRN.Api.csproj -- --seed",
    "db:setup": "dotnet run --project APItrackGRN/src/APItrackGRN.Api/APItrackGRN.Api.csproj -- --migrate --seed",
    "db:script": "powershell -NoProfile -ExecutionPolicy Bypass -File APItrackGRN/scripts/generate-schema.ps1",
    "build": "npm run ui:build && npm run api:build",
    "test": "npm run api:test && npm run ui:e2e"
  }
}
